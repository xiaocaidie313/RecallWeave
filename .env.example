# Docker Compose reads .env; Go entry points read the PROCESS environment only.
# Copying this file does not export values into PowerShell/bash.
RECALLWEAVE_DB_USER=postgres
RECALLWEAVE_DB_PASSWORD=recallweave-local
RECALLWEAVE_DB_NAME=recallweave
RECALLWEAVE_DB_PORT=5434

# Export these in the process that launches Go / DeepSeek Harness when needed.
# RECALLWEAVE_LLM_API_KEY=
# RECALLWEAVE_MCP_TOKEN=
# TAVILY_API_KEY=
